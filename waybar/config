{
    "layer": "top",
    "position": "top",
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "height": 25,
    "width": "95%",
    "spacing": 2,
    
    "modules-left": ["clock"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["tray"],

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d.%m.%Y}"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8,
        "margin-left": 4,
        "margin-right": 4
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "active": "○",
            "default": "•",
            "urgent": "!"
   	}
    }
}
